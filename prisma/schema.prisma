// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String   @default("")
  createdAt    DateTime @default(now())
  labels       Label[]
}

model Label {
  id               String   @id @default(cuid())
  slug             String   @unique
  nome             String
  alcol            Float    @default(0)
  acidita          Float    @default(0)
  zuccheroResiduo  Float    @default(0)
  glicerinaManuale Boolean  @default(false)
  ingredientiJson  String   @default("[]")
  riciclaggio      String   @default("manuale")
  azienda          String   @default("")
  paese            String   @default("")
  createdAt        DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
