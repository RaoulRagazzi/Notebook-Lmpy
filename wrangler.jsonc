{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splendoria",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splendoria-db",
      "database_id": "1a46b8b0-2e6f-44cf-a22f-4950259f9434"
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "raoul.ragazzi@apple.bz",
      "allowed_sender_addresses": ["contatti@splendoria.vip"]
    }
  ]
}
