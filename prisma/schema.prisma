// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nome         String    @default("")
  createdAt    DateTime  @default(now())
  labels       Label[]
  capitolo     Capitolo?
  ordini       Ordine[]
}

// Splendoria: il primo capitolo gratuito del cliente (uno per account)
model Capitolo {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titolo    String   @default("")
  genere    String   @default("Autobiografia")
  testo     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Splendoria: richiesta di conversione a una formula del listino
model Ordine {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formula   String
  prezzo    Int
  stato     String   @default("richiesta")
  createdAt DateTime @default(now())
}

model Label {
  id               String     @id @default(cuid())
  slug             String     @unique
  nome             String
  alcol            Float      @default(0)
  acidita          Float      @default(0)
  zuccheroResiduo  Float      @default(0)
  glicerinaManuale Boolean    @default(false)
  ingredientiJson  String     @default("[]")
  riciclaggio      String     @default("manuale")
  azienda          String     @default("")
  paese            String     @default("")
  createdAt        DateTime   @default(now())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wineStory        WineStory?
}

model WineStory {
  id                String   @id @default(cuid())
  labelId           String   @unique
  label             Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  annata            String   @default("")
  denominazione     String   @default("")
  vitigno           String   @default("")
  zonaProduzione    String   @default("")
  vigneto           String   @default("")
  vinificazione     String   @default("")
  affinamento       String   @default("")
  noteDegustazione  String   @default("")
  temperaturaServizio String @default("")
  abbinamenti       String   @default("")
  certificazioni    String   @default("")
  storiaVino        String   @default("")
  raccontoCantina   String   @default("")
  premiJson         String   @default("[]")
  testoSocialBreve  String   @default("")
  testoSitoLungo    String   @default("")

  immagineBottiglia String   @default("")
  immagineEtichetta String   @default("")
  immagineVigneto   String   @default("")
  immagineCantina   String   @default("")

  lingua            String   @default("it")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
